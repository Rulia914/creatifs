RewriteEngine on

# --------------------------------------------
# Fichiers ou dossiers réels (css, js, images, pdf, zip, etc.) : pas de réécriture, on les sert tels quels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --------------------------------------------
# RÈGLES DE RÉ-ÉCRITURE
# DETAIL PROJET.show
# PATTERN : /projects/id/slug.html 
# URL : ?projectId=show&id=x
RewriteRule ^projects/([1-9][0-9]*)/[a-z0-9]+(-[a-z0-9]+)*\.html$ index.php?projectId=show&id=$1 [L]

# FORMULAIRE D'AJOUT
# PATTERN : /projects/add/form.html
# URL : ?projectId=addForm
RewriteRule ^projects\/add\/form\.html$ index.php?projectId=addForm [L]

# TRAITEMENT DU FORMULAIRE D'AJOUT
# PATTERN : /projects/add/insert.html
# URL : ?projectId=addInsert
RewriteRule ^projects\/add\/insert\.html$ index.php?projectId=addInsert [L]

# SUPPRESSION D'UN PROJET
# PATTERN : /projects/delete/x/slug
# URL : index.php?projects=delete&id=x
RewriteRule ^projects/delete/([1-9][0-9]*)/[a-z0-9]+(-[a-z0-9]+)*\.html$ index.php?projects=delete&id=$1 [L]

# MODIFICATION D'UN FORMULAIRE
# PATTERN : /projects/id/slug/edit/form.html
# URL : index.php?projects=editForm&id=x
RewriteRule ^projects/([1-9][0-9]*)/([^/]+)/edit/form\.html$ index.php?projects=editForm&id=$1 [L]

# TRAITEMENT DU FORMULAIRE DE MODIFICATION
# PATTERN : /projects/id/slug/edit/update.html
# URL : ?projects=editUpdate&id=x
RewriteRule ^projects/([1-9][0-9]*)/([^/]+)/edit/update\.html$ index.php?projects=editUpdate&id=$1 [L]


# --------------------------------------------
# FALLBACK
# Toute autre URL non prise en charge par une route ci-dessus part vers le front controller
RewriteRule ^ index.php [L]